# ============================================================
# 本地开发用的环境变量样例。复制成 .env 即可。
#
# ★ 键名与 GitHub Actions 里的 Secrets / Variables **完全一致**，这是刻意的：
#   common/config.py 与 scidaily/settings.py 都走 os.getenv，
#   所以同一份代码在本地（读 .env）和 CI（读 Actions 注入）之间零分支。
#   load_dotenv 对不存在的文件不报错——这一点保证了它成立。
# ============================================================

# ---------- 运行环境 ----------
# local = 你本机（部分源在墙内不通）
# ci    = GitHub runner（境外 IP，反而通；且不读缓存）
SCIDAILY_ENV=local

# ---------- 礼貌池联系方式 ----------
# ★ 学术 API 的礼貌池：带邮箱的请求会被优先服务。
#   OpenAlex / Crossref / PubMed 都认这个。
#   留空也能跑，但请填上——这是对公共基础设施的基本礼貌。
SCIDAILY_CONTACT=you@example.com

# ---------- LLM ----------
# 先用 mock（离线，不花钱）-> 再用 github 在 CI 上拿真实输出 -> 充值后翻成 deepseek
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDER=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

GITHUB_MODELS_TOKEN=
GITHUB_MODELS_URL=https://models.github.ai/inference
GITHUB_MODELS_MODEL=openai/gpt-4o-mini

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:4b-fast
OLLAMA_REASONING_EFFORT=none

MAX_STEPS=8
TEMPERATURE=0.7
LLM_TIMEOUT_S=180

# ---------- PubMed（可选，有则提速到 10 req/s）----------
# 在 NCBI 账号设置里申请，免费。
NCBI_API_KEY=

# ---------- 邮件推送 ----------
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_USERNAME=
# ★ 是 SMTP 授权码，不是邮箱登录密码。
#   QQ 邮箱：设置 -> 账户 -> 开启 POP3/SMTP 服务 -> 生成授权码
MAIL_AUTH_CODE=
MAIL_TO=

# ---------- 运维 ----------
# 死手开关（healthchecks.io 之类）。跑成功就 ping 一下，
# 到点没 ping 就说明任务根本没跑起来——这是 cron 静默失败唯一的解药。
HEALTHCHECK_URL=
